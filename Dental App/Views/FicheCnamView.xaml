<UserControl x:Class="Dental_App.Views.FicheCnamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource PrimaryBackground}">

	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Titre -->
		<TextBlock Text="Fiche CNAM"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,24"/>

		<!-- Famille + Sous-famille -->
		<Grid Grid.Row="1" Margin="0,0,0,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="24"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0">
				<TextBlock Text="Famille"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12" Margin="0,0,0,6"/>
				<ComboBox ItemsSource="{Binding Familles}"
                          SelectedItem="{Binding FamilleSelectionnee}"
                          Background="{DynamicResource SecondaryBackground}"
                          Foreground="{DynamicResource TextPrimary}"
                          BorderThickness="0"
                          Padding="12,8"
                          Height="40"/>
			</StackPanel>

			<StackPanel Grid.Column="2">
				<TextBlock Text="Sous-famille"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12" Margin="0,0,0,6"/>
				<ComboBox ItemsSource="{Binding SousFamilles}"
                          SelectedItem="{Binding SousFamilleSelectionnee}"
                          Background="{DynamicResource SecondaryBackground}"
                          Foreground="{DynamicResource TextPrimary}"
                          BorderThickness="0"
                          Padding="12,8"
                          Height="40"/>
			</StackPanel>
		</Grid>

		<!-- Acte -->
		<StackPanel Grid.Row="2" Margin="0,0,0,24">
			<TextBlock Text="Acte médical"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12" Margin="0,0,0,6"/>
			<ComboBox ItemsSource="{Binding Actes}"
                      SelectedItem="{Binding ActeSelectionne}"
                      DisplayMemberPath="Designation"
                      Background="{DynamicResource SecondaryBackground}"
                      Foreground="{DynamicResource TextPrimary}"
                      BorderThickness="0"
                      Padding="12,8"
                      Height="40"/>
		</StackPanel>

		<!-- Code + Cotation -->
		<Border Grid.Row="3"
                Background="{DynamicResource SecondaryBackground}"
                CornerRadius="12"
                Padding="24">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<TextBlock Text="Code"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12" Margin="0,0,0,6"/>
					<TextBlock Text="{Binding ActeSelectionne.Code}"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="22" FontWeight="Bold"/>
				</StackPanel>

				<StackPanel Grid.Column="1">
					<TextBlock Text="Cotation"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12" Margin="0,0,0,6"/>
					<TextBlock Text="{Binding ActeSelectionne.Cotation}"
                               Foreground="{DynamicResource AccentColor}"
                               FontSize="22" FontWeight="Bold"/>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</UserControl>